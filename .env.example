# Zyphnaro — environment variables (example)
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or put secret keys in NEXT_PUBLIC_ variables.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase --------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI providers (server-side only, never exposed to the client) ---------
GEMINI_API_KEY=
# Swappable without any code change if a specific model isn't available on
# your plan/tier — see /docs/ai-integration.md
GEMINI_MODEL=gemini-3.5-flash
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Source integrations ----------------------------------------------------
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=

ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Adzuna's API is per-country. Swappable without code changes — see
# /docs/source-integrations.md for supported country codes.
ADZUNA_COUNTRY=us

# LinkedIn, Indeed, Wellfound, Remote OK, We Work Remotely and Remotive
# integrations require partnership/API approval — see /docs/source-integrations.md
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Scheduled sync (Vercel Cron) -------------------------------------------
# Set this to any random string, then add the SAME value in your Vercel
# project's environment variables. Vercel automatically sends it as an
# Authorization header on cron-triggered requests — this is what stops
# anyone else from triggering a sync by just visiting the URL.
# See /docs/backend-integration.md, "Phase 6 quickstart".
CRON_SECRET=

# --- Payments (future) ------------------------------------------------------
# PAYMENT INTEGRATION:
# Future integration can use Stripe, Paystack, Flutterwave, or another
# supported payment provider. Do not implement real payments in the prototype.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Password reset: set to true ONLY after custom SMTP + {{ .Token }} in the Reset Password email template.
NEXT_PUBLIC_RESET_CODE_ENABLED=false
